<% if (locals.ERROR) { %>
<div class="alert alert-error">
<%= locals.ERROR %>
</div>
<% } %>
<% if (locals.PASSWORD_ERRORS) { %>
<div class="alert alert-error">
  <p style="margin-bottom:6px">Password does not meet requirements (at least 3 of 4 character types required):</p>
  <ul style="margin:0;padding-left:18px">
    <% locals.PASSWORD_ERRORS.forEach(function(rule) { %>
    <li><%= rule.passed ? '✓' : '✗' %> <%= rule.label %></li>
    <% }) %>
  </ul>
</div>
<% } %>
<% if (locals.SUCCESS) { %>
<div class="alert alert-success">
Configuration updated and server restarted.
</div>
<% } %>