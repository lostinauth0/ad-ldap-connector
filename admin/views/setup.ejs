<!DOCTYPE html>
<html lang="en">
<head>
  <title>Auth0 | AD LDAP Connector Setup</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="https://auth0.com/auth0-styleguide/img/favicon.png">
  <link rel="stylesheet" type="text/css" href="//fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800">
  <link rel="stylesheet" type="text/css" href="/main.min.css">
  <link rel="stylesheet" type="text/css" href="/custom.css">
</head>
<body>
  <div id="header">
    <h1>Auth0</h1>
  </div>
  <div class="wrapper">
    <div id="content" style="margin-left: 0;">
      <section id="configuration-section" class="content-page current">
        <div id="content-header">
          <h1>AD LDAP Connector Configuration</h1>
        </div>
        <div class="container-fluid flat">
          <% if (locals.ERROR) { %>
          <div class="alert alert-error"><%= locals.ERROR %></div>
          <% } %>
          <% if (locals.PASSWORD_ERRORS) { %>
          <div class="alert alert-error">
            <p style="margin-bottom:6px">Password does not meet requirements (at least 3 of 4 character types required):</p>
            <ul style="margin:0;padding-left:18px">
              <% locals.PASSWORD_ERRORS.forEach(function(rule) { %>
              <li><%= rule.passed ? '✓' : '✗' %> <%= rule.label %></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
          <div class="widget-box">
            <div class="widget-title">
              <h5>Set Admin Password</h5>
            </div>
            <div class="widget-content">
              <p class="help-block">No admin password has been configured. Set a password to secure the admin console.</p>
              <form method="POST" action="/setup" class="form-horizontal">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="control-group">
                  <label class="control-label" for="password">Password</label>
                  <div class="controls">
                    <input type="password" name="password" id="password" autofocus required minlength="8">
                    <span class="help-block">
                      <ul>
                        <li>At least 8 characters</li>
                        <li>At least 3 of the following:
                          <ul>
                            <li>Uppercase letters</li>
                            <li>Lowercase letters</li>
                            <li>Numbers</li>
                            <li>Special characters</li>
                          </li>
                      </ul>
                    </span>
                  </div>
                </div>
                <div class="control-group">
                  <label class="control-label" for="confirm">Confirm Password</label>
                  <div class="controls">
                    <input type="password" name="confirm" id="confirm" required minlength="8">
                  </div>
                </div>
                <div class="control-group">
                  <div class="controls">
                    <button type="submit" class="btn btn-primary">Set Password</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script src="/jquery.min.js"></script>
  <script src="/bootstrap.min.js"></script>
</body>
</html>
