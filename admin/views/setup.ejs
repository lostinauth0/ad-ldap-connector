<!DOCTYPE html>
<html lang="en">
<head>
  <title>Auth0 | AD LDAP Connector Setup</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="https://auth0.com/auth0-styleguide/img/favicon.png">
  <link rel="stylesheet" type="text/css" href="//fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800">
  <link rel="stylesheet" type="text/css" href="/main.min.css">
  <link rel="stylesheet" type="text/css" href="/custom.css">
</head>
<body>
  <div id="header">
    <h1>Auth0</h1>
  </div>
  <div class="wrapper">
    <div id="content" style="margin-left: 0;">
      <section id="configuration-section" class="content-page current">
        <div id="content-header">
          <h1>AD LDAP Connector Configuration</h1>
        </div>
        <div class="container-fluid flat">
          <% if (locals.ERROR) { %>
          <div class="alert alert-error"><%= locals.ERROR %></div>
          <% } %>
          <% if (locals.PASSWORD_ERRORS) { %>
          <div class="alert alert-error">
            <p style="margin-bottom:6px">Password does not meet requirements:</p>
            <ul style="margin:0;padding-left:18px">
              <% locals.PASSWORD_ERRORS.forEach(function(rule) { %>
              <li><%= rule.passed ? '✓' : '✗' %> <%= rule.label %></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
          <div class="widget-box">
            <div class="widget-title">
              <h5>Set Admin Password</h5>
            </div>
            <div class="widget-content">
              <p class="help-block">No admin password has been configured. Set a password to secure the admin console.</p>
              <%- include('form_change_password', { askCurrentPassword: false }) -%>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script src="/jquery.min.js"></script>
  <script src="/bootstrap.min.js"></script>
</body>
</html>
