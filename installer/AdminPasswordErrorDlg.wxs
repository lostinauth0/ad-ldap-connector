<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <UI>
            <Dialog Id="AdminPasswordErrorDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
                <Control Id="Return" Type="PushButton" X="100" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Return">
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
                <Control Id="Text" Type="Text" X="15" Y="15" Width="230" Height="30" TabSkip="no" Text="[ADMIN_PASSWORD_ERROR]" />
            </Dialog>
        </UI>
    </Fragment>
</Wix>
